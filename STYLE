body {
    font-family: Arial,  sans-serif; /* Font family */
    font-size: 11px; /* O tamanho da fonte principal<p></p> tag  */
    background-color: hsla(180, 1%, 83%, 0.63); /* A cor do plano de fundo da página */
    color: #000000; /* A cor do texto */ 

}
h1 {
    
    color: #0d0441; /* A cor do cabeçalho */
    font-size: 30px; /* A cor da fonte do cabeçalho */
    font-family: Georgia, serif; /* A font usada no cabeçalho*/
}

@keyframes color-change {
    0%   { color: rgb(3, 168, 31); }
    50%  { color: red; }
    100% { color: blue; }
}
h1:hover { animation: color-change 3s infinite; }
